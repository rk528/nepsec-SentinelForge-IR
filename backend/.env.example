# Copy to backend/.env for local development. Never commit the real file.
# All values below are placeholders.

APP_ENV=development
# Pooled connection string (Neon: the "-pooler" host). Used by the API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct connection string (Neon: host without "-pooler"). Used only by Alembic migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Local development over http needs non-secure cookies. Keep true in production.
COOKIE_SECURE=false
# Enables passwordless sign-in to the synthetic demo workspace. Never enable for real data.
DEMO_MODE=true

# Optional threat intelligence providers. The app works without them.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
# NepSec Intel (https://nepsecintel.kuinkel.com): an API key from its Workspace page (Pro or admin account).
NEPSECINTEL_API_KEY=
# NEPSECINTEL_BASE_URL=https://nepsecintel.kuinkel.com

# Optional: email welcome messages and password reset links through Resend (https://resend.com).
# Without a key, the admin is shown the temporary password and link once instead.
RESEND_API_KEY=
MAIL_FROM=SentinelForge IR <no-reply@kuinkel.com>
# Optional mailbox that receives replies (helps deliverability).
MAIL_REPLY_TO=
# Public frontend URL used to build links in emails.
APP_BASE_URL=http://127.0.0.1:3000
