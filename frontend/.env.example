# Copy to frontend/.env.local for local development. Never commit the real file.
# Server-only: the URL the Next.js server proxies /api/* to. It has no NEXT_PUBLIC_
# prefix, so it is never included in the browser bundle. Read at build time.
BACKEND_URL=http://127.0.0.1:8000

# End-to-end tests (optional)
# BASE_URL=http://127.0.0.1:3000
# PW_CHANNEL=chrome
